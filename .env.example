# WinCi — copy to .env (never commit .env)
MODE=paper
# MODE=live  # requires Binance keys; spot trade only, NO withdraw

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# DeepSeek AI (optional) — https://api.deepseek.com
# Paper mode works without this key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Risk
MIN_NOTIONAL_USD=1
MAX_POSITION_USD=500
DAILY_LOSS_LIMIT_USD=50
PAPER_STARTING_USDT=10000

# Engine
ENGINE_HOST=0.0.0.0
ENGINE_PORT=8787
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
