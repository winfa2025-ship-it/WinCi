{
  "appId": "com.winci.app",
  "appName": "WinCi",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "GoogleAuth": {
      "scopes": ["profile", "email"],
      "forceCodeForRefreshToken": false
    }
  }
}
